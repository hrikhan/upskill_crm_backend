PORT=5000
NODE_ENV=development
API_PREFIX=api/v1

# Neon Serverless PostgreSQL Cloud URL
DATABASE_URL=postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Upstash Serverless Redis Cloud URL
REDIS_URL=rediss://default:your_token@your-redis-endpoint.upstash.io:6379

# JWT Secrets
JWT_SECRET=super_strong_jwt_access_secret_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_strong_jwt_refresh_secret_32_characters
JWT_REFRESH_EXPIRES_IN=7d

# Allowed Frontend Origins (Local Vite + Production)
CORS_ORIGIN=http://localhost:5173,https://crm.yourdomain.com
